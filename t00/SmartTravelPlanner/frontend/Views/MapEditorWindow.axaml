<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RouteEngineUI.Views.MapEditorWindow"
        Title="Realm Map"
        Width="700"
        Height="600"
        MinWidth="600"
        MinHeight="500"
        Background="#070707"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Classes="dd-header" Text="CURRENT REALM MAP" />

        <ListBox Grid.Row="1" x:Name="MapList" SelectionChanged="OnMapSelectionChanged" Classes="dd-list" Margin="0,0,0,16" />

        <Grid Grid.Row="2"
              ColumnDefinitions="*,12,*,12,120">

            <StackPanel Grid.Column="0">
                <TextBlock Classes="dd-tblock" Text="City A:" />

                <TextBox x:Name="FromCity" Classes="dd-tbox" PlaceholderText="Kyiv" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Classes="dd-tblock" Text="City B:" />

                <TextBox x:Name="ToCity" Classes="dd-tbox" PlaceholderText="Lviv" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Classes="dd-tblock" Text="Distance, km:" />

                <TextBox x:Name="DistInput" Classes="dd-tbox" PlaceholderText="540" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="*,12,*">
            <Button Grid.Column="0" Classes="dd-btn" Content="ADD / UPDATE" Click="OnAddConnectionClick" />

            <Button Grid.Column="2" Classes="dd-btn" Content="REMOVE CONNECTION" Click="OnRemoveConnectionClick" />
        </Grid>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#FF8C8C" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="False" />

        <Button Grid.Row="5" Classes="dd-btn" Content="DONE" Margin="0,16,0,0" Click="OnDoneClick" />
    </Grid>
</Window>